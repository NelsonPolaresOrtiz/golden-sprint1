{
  "info": {
    "_postman_id": "c794e502-3112-4299-8d19-4bc2b6f10c3f",
    "name": "GOLDEN Lubricantes & Filtros - API Test Suite",
    "description": "# Suite Profesional de Pruebas Automatizadas (Postman v2.1)\n\n**GOLDEN Lubricantes & Filtros — Distribución Automotriz Mayorista & Minorista (Sucre, Bolivia)**\n\nEsta colección implementa una batería completa de pruebas de integración, seguridad RBAC, transacciones de venta con QR y notificaciones para ser ejecutada tanto individualmente como en lote con el **Postman Collection Runner** o **Newman**.\n\n### Variables Requeridas:\n- `base_url`: Endpoint raíz (`https://golden-sprint1.onrender.com` o `http://localhost:3000`)\n- `admin_email` / `admin_pass`: Credenciales administrativas\n- `cliente_email` / `cliente_pass`: Credenciales de cliente/taller\n- `token_admin` y `token_cliente`: Se autocompletan en la carpeta 01\n- `ultimo_pedido_id` y `ultimo_producto_id`: Se autocompletan en las carpetas 02 y 03.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Autenticación y Control de Acceso (RBAC)",
      "description": "Pruebas de validación de identidad, emisión de sesión y bloqueo estricto de cruce de portales entre personal administrativo y clientes.",
      "item": [
        {
          "name": "Login Administrador (ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Estructura de respuesta contiene usuario y credenciales\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"usuario\");",
                  "    pm.expect(jsonData.usuario).to.have.property(\"id\");",
                  "    pm.expect(jsonData.usuario).to.have.property(\"email\");",
                  "    pm.expect(jsonData.usuario).to.have.property(\"rol\");",
                  "});",
                  "",
                  "pm.test(\"Rol autenticado es ADMIN y almacenamiento en token_admin\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.usuario.rol).to.eql(\"ADMIN\");",
                  "    ",
                  "    // Guardar token/rol en variables de entorno",
                  "    pm.environment.set(\"token_admin\", jsonData.usuario.rol);",
                  "    pm.environment.set(\"admin_id\", jsonData.usuario.id);",
                  "    pm.environment.set(\"admin_email\", jsonData.usuario.email);",
                  "});",
                  "",
                  "pm.test(\"Tiempo de respuesta óptimo (< 2000ms)\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_pass}}\",\n  \"tipo_portal\": \"INTERNO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "description": "Autenticación del Administrador en el Portal Interno ERP. Almacena 'token_admin' en el entorno para peticiones privilegiadas subsiguientes."
          },
          "response": []
        },
        {
          "name": "Login Cliente (CLIENTE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Estructura de respuesta contiene objeto usuario\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"usuario\");",
                  "    pm.expect(jsonData.usuario).to.have.property(\"id\");",
                  "});",
                  "",
                  "pm.test(\"Rol autenticado es CLIENTE y almacenamiento en token_cliente\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect([\"CLIENTE\", \"CLIENTE_B2B\", \"CLIENTE_B2C\"]).to.include(jsonData.usuario.rol);",
                  "    ",
                  "    // Guardar token/rol y cliente_id en variables de entorno",
                  "    pm.environment.set(\"token_cliente\", jsonData.usuario.rol);",
                  "    pm.environment.set(\"cliente_id\", jsonData.usuario.id);",
                  "    pm.environment.set(\"cliente_email\", jsonData.usuario.email);",
                  "});",
                  "",
                  "pm.test(\"Tiempo de respuesta óptimo (< 2000ms)\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{cliente_email}}\",\n  \"password\": \"{{cliente_pass}}\",\n  \"tipo_portal\": \"CLIENTE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "description": "Autenticación de un Cliente/Taller en el Catálogo Comercial. Guarda 'token_cliente' y 'cliente_id' en variables de entorno."
          },
          "response": []
        },
        {
          "name": "Prueba de Seguridad: Cruce de Portal (Negativo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Bloqueo estricto con HTTP 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "",
                  "pm.test(\"Mensaje de error especifica restricción de portal para rol Cliente\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"error\");",
                  "    pm.expect(jsonData.error).to.include(\"Acceso denegado\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{cliente_email}}\",\n  \"password\": \"{{cliente_pass}}\",\n  \"tipo_portal\": \"INTERNO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "description": "Verifica que un usuario con rol CLIENTE no pueda vulnerar el sistema intentando ingresar al portal administrativo INTERNO."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02. Catálogo e Inventario",
      "description": "Consultas públicas del catálogo de productos y validación de permisos granulares RBAC para creación/edición de repuestos.",
      "item": [
        {
          "name": "Listar Productos Públicos (GET /api/productos)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Catálogo no vacío devuelto como Array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"array\");",
                  "    pm.expect(jsonData.length > 0).to.be.true;",
                  "});",
                  "",
                  "pm.test(\"Estructura comercial requerida en productos (SKU, nombre, precio, stock)\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var prod = jsonData[0];",
                  "    pm.expect(prod).to.have.property(\"id\");",
                  "    pm.expect(prod).to.have.property(\"sku\");",
                  "    pm.expect(prod).to.have.property(\"nombre\");",
                  "    pm.expect(prod).to.have.property(\"precio\");",
                  "    pm.expect(prod).to.have.property(\"stock\");",
                  "});",
                  "",
                  "pm.test(\"Tiempo de respuesta < 1500ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1500);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/productos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "description": "Consulta pública del catálogo automotriz sin requerir inicio de sesión previo."
