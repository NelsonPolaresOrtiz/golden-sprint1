          }
        }
      ]
    },
    {
      "name": "04. Logística, Créditos y Auditoría",
      "description": "Endpoints de monitoreo de cartera de créditos B2B para talleres mecánicos y trazabilidad en la bitácora de auditoría.",
      "item": [
        {
          "name": "Consultar Líneas de Crédito B2B",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Estructura contiene resumen y detalle de créditos\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"resumen\");",
                  "    pm.expect(jsonData).to.have.property(\"creditos\");",
                  "    pm.expect(jsonData.creditos).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Métricas de crédito expresadas en valores numéricos válidos en Bolivianos\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.resumen.total_limite_asignado).to.be.at.least(0);",
                  "    pm.expect(jsonData.resumen.total_cartera_deudora).to.be.at.least(0);",
                  "    pm.expect(jsonData.resumen.total_credito_disponible).to.be.at.least(0);",
                  "});",
                  "",
                  "pm.test(\"Tiempo de respuesta < 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
