    {
      "name": "03. Pedidos, Pagos QR y Cobranzas",
      "description": "Flujo integral de creación de órdenes con Pago QR Interoperable, simulación de conciliación bancaria por Webhook y consulta de cobranzas.",
      "item": [
        {
          "name": "Crear Pedido con Pago QR Directo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 201 Created o 200 OK\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test(\"Orden de compra creada y guardada en ultimo_pedido_id\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"ok\", true);",
                  "    var orderId = jsonData.pedidoId || jsonData.id;",
                  "    pm.expect(orderId).to.be.a(\"number\");",
                  "    pm.environment.set(\"ultimo_pedido_id\", orderId);",
                  "});",
                  "",
                  "pm.test(\"Método de pago QR_DIRECTO y estado PENDIENTE\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.metodo_pago).to.eql(\"QR_DIRECTO\");",
                  "    pm.expect(jsonData.estado_pago).to.eql(\"PENDIENTE\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": 38,\n  \"total\": 170,\n  \"metodo_pago\": \"QR_DIRECTO\",\n  \"comprobante_ref\": \"REF-QR-TEST-{{$timestamp}}\",\n  \"numero_operacion\": \"OP-YAPE-{{$timestamp}}\",\n  \"banco_origen\": \"QR Interoperable / SIMPLE / Yape\",\n  \"carrito\": [\n    {\n      \"id\": 1,\n      \"sku\": \"LUB-SYN-5W30\",\n      \"nombre\": \"Aceite Sintético 5W-30\",\n      \"precio\": 85,\n      \"cantidad\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/pedidos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "pedidos"
              ]
            },
            "description": "Registra una orden de compra con método QR Directo, dejando el estado inicial en PENDIENTE hasta la confirmación del pago."
          },
          "response": []
        },
        {
          "name": "Simular Webhook Confirmación QR Bancario (POST /api/pagos/webhook-qr)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Webhook procesado y aceptado\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"ok\", true);",
                  "    pm.expect(jsonData).to.have.property(\"recibido\", true);",
                  "});",
                  "",
                  "pm.test(\"Estado de pago actualizado automáticamente a VERIFICADO\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.estado_pago).to.eql(\"VERIFICADO\");",
                  "    pm.expect(jsonData.pedido_id).to.eql(parseInt(pm.environment.get(\"ultimo_pedido_id\")));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pedido_id\": \"{{ultimo_pedido_id}}\",\n  \"referencia\": \"REF-HOOK-{{$timestamp}}\",\n  \"monto\": 170,\n  \"estado\": \"SUCCESS\",\n  \"id_transaccion\": \"TX-BCP-INTEROP-{{$timestamp}}\",\n  \"banco\": \"Banco de Crédito BCP / SIMPLE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/pagos/webhook-qr",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "pagos",
                "webhook-qr"
              ]
            },
            "description": "Simula la llamada automática del Webhook Bancario / Pasarela QR confirmando que el cliente transfirió los fondos, actualizando el pedido a VERIFICADO."
          },
          "response": []
        },
        {
          "name": "Listar Pedidos y Cobranzas (GET /api/pedidos)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Listado de pedidos devuelto como Array no vacío\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"array\");",
                  "    pm.expect(jsonData.length > 0).to.be.true;",
                  "});",
                  "",
                  "pm.test(\"El pedido conciliado figura con estado VERIFICADO\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var targetId = parseInt(pm.environment.get(\"ultimo_pedido_id\"));",
                  "    var match = jsonData.find(p => p.id === targetId);",
                  "    pm.expect(match).to.not.be.undefined;",
                  "    pm.expect(match.estado_pago).to.eql(\"VERIFICADO\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/pedidos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "pedidos"
              ]
            },
            "description": "Consulta el listado general de pedidos y cuentas por cobrar para auditar el estado financiero."
          },
          "response": []
        },
        {
          "name": "Registrar Venta Directa en Tienda (POST /api/ventas/directa)",
          "event": [
            {
