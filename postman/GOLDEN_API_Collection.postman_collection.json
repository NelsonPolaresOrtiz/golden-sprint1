              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Bloqueo estricto con HTTP 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "",
                  "pm.test(\"Mensaje de error especifica bloqueo RBAC de rol no gestor\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"error\");",
                  "    pm.expect(jsonData.error).to.include(\"403 Forbidden\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-usuario-rol",
                "value": "{{token_cliente}}"
              },
              {
                "key": "x-usuario-email",
                "value": "{{cliente_email}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_cliente}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"HACK-CLI-{{$timestamp}}\",\n  \"nombre\": \"Intento no autorizado de creación\",\n  \"categoria\": \"Aceites de Motor\",\n  \"precio\": 25,\n  \"stock\": 100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/productos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "description": "Comprueba que un cliente o atacante que intente registrar repuestos mediante API sea rechazado con HTTP 403."
          },
          "response": []
        },
        {
          "name": "Crear Producto de Prueba (ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 201 Created o 200 OK\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test(\"Producto creado con identificador y guardado en variable ultimo_producto_id\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"id\");",
                  "    pm.expect(jsonData.id).to.be.a(\"number\");",
                  "    pm.environment.set(\"ultimo_producto_id\", jsonData.id);",
                  "});",
                  "",
                  "pm.test(\"Mensaje de éxito retornado por el backend\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"mensaje\");",
                  "});"
