# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - GOLDEN LUBRICANTES & FILTROS
# ==============================================================================

# Puerto de la aplicación (Render asigna PORT dinámicamente)
PORT=3000

# Credenciales de Gmail (nodemailer) para envío automatizado de correos
# Nota: GMAIL_APP_PASSWORD debe ser una "Contraseña de Aplicación" de 16 caracteres de Google
GMAIL_USER=tu_correo@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_FROM_NAME="GOLDEN Lubricantes & Filtros"

# URL base para enlaces generados en correos proforma y confirmaciones
BASE_APP_URL=https://golden-sprint1.onrender.com
